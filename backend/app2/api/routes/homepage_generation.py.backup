    except Exception as e:
        logger.error(f"Failed to start homepage generation stream: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to start stream: {str(e)}")

@router.delete("/request/{request_id}")
async def cancel_homepage_generation(
    request_id: str,
    current_user: Dict[str, Any] = Depends(get_current_user)
):
    """Cancel a homepage generation request"""
    try:
        logger.info(f"Received cancel request for {request_id}")
        return {"status": "cancelled"}
        
    except Exception as e:
        logger.error(f"Failed to cancel request {request_id}: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to cancel request: {str(e)}")