# Backend environment. Copy to backend/.env (git-ignored) and fill in.
# For the local Supabase stack, `make local-env` writes backend/.env for you.
# Variables already exported in the shell take precedence over this file.

APP_ENV=dev          # "prod" switches URLs below and Stripe to PROD_STRIPE_*
DEBUG=false

# --- Supabase (auth, storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key                 # anon / publishable key
SUPABASE_SECRET_KEY=your-service-role-key  # service role key (admin operations)
SUPABASE_JWT_SECRET=your-jwt-secret
# Access tokens are verified locally against the project's JWKS (ES256/RS256);
# set to "false" to verify every token through the Supabase auth API instead.
AUTH_USE_JWT_VERIFICATION=true

# --- Postgres (required) ---
# SSL is required unless the URL says otherwise, e.g. `?sslmode=disable` for a local Postgres.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis (required) ---
REDIS_URL=redis://localhost:6379
# "true" shares assistant request state across servers via Redis; "false" keeps it in memory.
USE_DISTRIBUTED_REQUESTS=false

# --- App URLs (defaults shown) ---
LOCAL_BASE_URL=http://localhost:8000
LOCAL_FRONTEND_BASE_URL=http://localhost:5173
PROD_BASE_URL=https://api.beatgen.com
PROD_FRONTEND_BASE_URL=https://app.beatgen.com

# --- AI assistant: one key per provider you use (see .scratch/app-refresh/spec.md) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=          # DeepSeek and Llama models
PERPLEXITY_API_KEY=          # optional research enhancement

# --- Audio generation ---
AUDIO_GENERATION_PROVIDER=fal   # fal | stability | vertex
FAL_KEY=
STABILITY_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=
GOOGLE_APPLICATION_CREDENTIALS=        # path to a service account JSON (deployed)
LOCAL_GOOGLE_APPLICATION_CREDENTIALS=  # path to a service account JSON (local)

# --- Stripe (DEV_* when APP_ENV=dev, PROD_* when APP_ENV=prod) ---
DEV_STRIPE_SECRET_KEY=sk_test_...
DEV_STRIPE_PUBLISHABLE_KEY=pk_test_...
DEV_STRIPE_WEBHOOK_SECRET=whsec_...
DEV_STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
DEV_STRIPE_STARTER_YEARLY_PRICE_ID=price_...
DEV_STRIPE_CREATOR_MONTHLY_PRICE_ID=price_...
DEV_STRIPE_CREATOR_YEARLY_PRICE_ID=price_...
DEV_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
DEV_STRIPE_PRO_YEARLY_PRICE_ID=price_...
# PROD_STRIPE_* mirrors the DEV_STRIPE_* names above.

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@beatgen.com
RESEND_FROM_NAME=BeatGen

# --- Legacy JWT settings (still read by app2/core/config.py) ---
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
