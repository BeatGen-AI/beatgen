# Frontend environment. Copy to frontend/.env.local (git-ignored) and fill in.
# For the local Supabase stack, `make local-env` writes .env.local for you.
# Variables already exported in the shell take precedence over these files.

# "dev" uses the dev-server proxy for API calls and DEV_VITE_* Stripe values;
# anything else is treated as production (PROD_VITE_* values).
VITE_APP_ENV=dev

# Supabase project URL used to build public asset URLs (soundfonts, drum samples, audio).
# REQUIRED: production builds fail without it. Set it but leave it EMPTY to use same-origin
# /storage/v1 URLs proxied by the dev server to DEV_SUPABASE_PROXY_TARGET (local stack).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Backend base URLs. In dev, leave VITE_LOCAL_BACKEND_URL empty to go through the dev-server
# proxy (vite.config.ts -> https://localhost:8000).
VITE_LOCAL_BACKEND_URL=
VITE_PROD_BACKEND_BASE_URL=https://api.beatgen.com

# Stripe (test mode values for dev, live values for prod).
DEV_VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
DEV_VITE_STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
DEV_VITE_STRIPE_STARTER_YEARLY_PRICE_ID=price_...
DEV_VITE_STRIPE_CREATOR_MONTHLY_PRICE_ID=price_...
DEV_VITE_STRIPE_CREATOR_YEARLY_PRICE_ID=price_...
DEV_VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
DEV_VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_...
PROD_VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
PROD_VITE_STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
PROD_VITE_STRIPE_STARTER_YEARLY_PRICE_ID=price_...
PROD_VITE_STRIPE_CREATOR_MONTHLY_PRICE_ID=price_...
PROD_VITE_STRIPE_CREATOR_YEARLY_PRICE_ID=price_...
PROD_VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
PROD_VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_...

# PostHog analytics (optional).
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# --- Dev server only (read by vite.config.ts, never exposed to the browser) ---
# Proxy /storage/v1 to this Supabase URL (pairs with an empty VITE_SUPABASE_URL).
DEV_SUPABASE_PROXY_TARGET=
# "false" serves plain HTTP instead of HTTPS from frontend/.cert (e.g. behind a TLS proxy).
DEV_SERVER_HTTPS=true
# "all", or comma-separated hosts the dev server answers to (".example.com" = subdomains).
DEV_SERVER_ALLOWED_HOSTS=
